---
import { SITE, SOCIAL_LINKS } from '@/config/site'

const year = new Date().getFullYear()
---

<footer
  id="footer"
  class="border-t border-paper/10 bg-bg-elevated py-10 text-stone sm:py-12"
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 sm:px-6 md:flex-row md:items-end md:justify-between md:px-8 lg:px-10 xl:max-w-7xl xl:px-12"
  >
    <div>
      <h2
        class="m-0 font-wordmark text-xl font-extrabold uppercase leading-none tracking-[var(--tracking-wordmark)] text-paper sm:text-2xl"
      >
        {SITE.name}
      </h2>
      <p class="mt-3 max-w-sm font-body text-sm leading-relaxed text-paper/70">
        {SITE.manifestoLine}
      </p>
    </div>
    <div class="flex flex-col gap-4 md:items-end">
      <nav aria-label="Social">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-display text-[0.58rem] uppercase tracking-[var(--tracking-ultra)] transition-colors hover:text-paper"
                  target="_blank"
                  rel="noreferrer"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="font-display text-[0.5rem] uppercase tracking-[var(--tracking-wide-editorial)] text-stone/80">
        © {year} {SITE.name}
      </p>
    </div>
  </div>
</footer>
